# Binance Hybrid Bot — .env.example
# انسخ هذا الملف إلى .env واملأ القيم. لا ترسل هذا الملف لأحد ولا تضعه في Git.
# مفاتيح Testnet فقط في البداية — من https://testnet.binance.vision (Spot)
# و https://testnet.binancefuture.com (Futures).
# لا تضع أبداً مفاتيح حساب حقيقي هنا قبل أن يثبت البوت نفسه أسابيع على Testnet.

# Binance API (Testnet by default)
BINANCE_API_KEY=YOUR_TESTNET_API_KEY_HERE
BINANCE_API_SECRET=YOUR_TESTNET_API_SECRET_HERE

# Telegram (اختياري — البوت يعمل بدونه)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# تشغيل
TRADING_MODE=spot
ENV=testnet
